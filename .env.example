# Copy to .env and fill in. Never commit .env.

# PostgreSQL — use a database in an account you control
DATABASE_URL=

# Gemma 4 — Gemini API (primary) and OpenRouter (fallback)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Sarvam — speech to text and text to speech
SARVAM_API_KEY=

# Phone line — Vobiz credentials and your assigned number, e.g. +9180XXXXXXXX
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=

# Keyed hash for caller numbers / web sessions: a long random value, set once, never change
# python -c "import secrets; print(secrets.token_urlsafe(32))"
CALLER_HASH_KEY=

# Locks citizens' contact details (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
CONTACT_ENCRYPTION_KEY=
# Officers sign in to the dashboard with this
OFFICER_PASSCODE=

# Public origin of this deployment (no trailing slash); used by phone streams and callbacks
PUBLIC_BASE_URL=

# Optional Telegram bot. Register https://YOUR_HOST/webhooks/telegram as its webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Optional Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Optional feature switches and model tuning (defaults are in backend/app/settings.py)
FEATURE_PHOTO_CHECK=true
FEATURE_CALLBACK=true
# LLM_LIVE_MODEL=gemma-4-26b-a4b-it
# LLM_BACKGROUND_MODEL=gemma-4-31b-it
# LLM_PRIMARY_TIMEOUT_S=2.5
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TRANSLATE_MODEL=mayura:v1
# SARVAM_TTS_SPEAKER=roopa
# SARVAM_TTS_PACE=0.95
# SARVAM_TTS_TEMPERATURE=0.7
# APP_VERSION=0.1.0
